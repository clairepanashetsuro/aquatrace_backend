# Render PostgreSQL connection string
DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST:PORT/DATABASE

# Frontend and CORS
FRONTEND_ORIGIN=
CORS_ORIGINS=http://localhost:3000

# JWT RS256 keys
# Supply actual key values through Render environment variables.
# Represent newline characters in PEM values as \n.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_ACCESS_TOKEN_MINUTES=30
JWT_REFRESH_TOKEN_DAYS=1
JWT_ISSUER=aquatrace-api
JWT_AUDIENCE=aquatrace-api

# OAuth
OAUTH_CLIENT_ID=aquatrace-pwa
OAUTH_REDIRECT_URI=
OAUTH_FRONTEND_ORIGIN=
OAUTH_AUTHORIZATION_CODE_MINUTES=5

# MFA
MFA_ENCRYPTION_KEY=

# External integrations
LOCATIONIQ_API_KEY=
GPS_INTEGRATION_API_KEY=

# Email
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

# Gemini RAG
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FILE_SEARCH_STORE_NAME=
