.
DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@localhost:5432/aquatrace

# Optional overrides. By default, the application uses the local secrets/ directory.
# JWT_PRIVATE_KEY_PATH=/absolute/path/to/jwt-private.pem
# JWT_PUBLIC_KEY_PATH=/absolute/path/to/jwt-public.pem
JWT_ACCESS_TOKEN_MINUTES=30
JWT_ISSUER=aquatrace-api

# OAuth 2.0 Authorization Code + PKCE.
# Set these when the PWA's actual Vercel URL is known.
OAUTH_CLIENT_ID=aquatrace-pwa
# Example format: https://YOUR-PWA.vercel.app/auth/callback
# OAUTH_REDIRECT_URI=
# Example format: https://YOUR-PWA.vercel.app
# OAUTH_FRONTEND_ORIGIN=

JWT_AUDIENCE=aquatrace-api
OAUTH_AUTHORIZATION_CODE_MINUTES=5
